  .eb-name .eb-word{ display:inline-flex; }
  .eb-name .eb-ch{
    display:inline-block;
    background:linear-gradient(176deg,#ffffff 0%, #f6f5f1 30%, #d8d8d3 60%, #8f8f89 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    filter:drop-shadow(0 1px 0 rgba(0,0,0,.85)) drop-shadow(0 3px 1px rgba(0,0,0,.45)) drop-shadow(0 26px 45px rgba(0,0,0,.75));
    opacity:0; transform:translateY(.5em) rotateX(-55deg);
    transition:opacity .7s cubic-bezier(.16,.84,.44,1), transform .7s cubic-bezier(.16,.84,.44,1);
    will-change:transform, opacity;
  }
  body.eb-loaded .eb-name .eb-ch{ opacity:1; transform:translateY(0) rotateX(0deg); }
  @media (hover:hover){
    .eb-name .eb-ch{ transition:opacity .7s cubic-bezier(.16,.84,.44,1), transform .35s cubic-bezier(.2,.9,.3,1); }
    .eb-name .eb-ch:hover{ transform:translateY(-.06em) scale(1.04); }
  }

  .eb-marquee{
    position:relative; z-index:3; width:100%; margin-top:1.9rem;
    overflow:hidden; padding:.85rem 0;
    -webkit-mask-image:linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
            mask-image:linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    transition:opacity 1s ease;
  }
  .eb-js .eb-marquee{ opacity:0; }
  body.eb-loaded .eb-marquee{ opacity:1; transition-delay:1s; }
  /* rules that fade out at both ends instead of cutting straight across */
  .eb-marquee::before, .eb-marquee::after{
    content:''; position:absolute; left:0; right:0; height:1px; pointer-events:none; z-index:2;
    background:linear-gradient(90deg, transparent, rgba(58,58,53,.85) 22%, rgba(58,58,53,.85) 78%, transparent);
  }
  .eb-marquee::before{ top:0; } .eb-marquee::after{ bottom:0; }
  .eb-marquee-track{
    display:flex; width:max-content; animation:eb-drift-l 34s linear infinite;
    font-size:12px; font-weight:600; letter-spacing:.26em; text-transform:uppercase; color:var(--body); white-space:nowrap;
  }
  .eb-marquee-track span{ padding:0 1.4rem; display:inline-flex; align-items:center; gap:1.4rem; }
  .eb-marquee-track i{ font-style:normal; color:var(--gold); font-size:14px; }
  @keyframes eb-drift-l{ from{ transform:translateX(0); } to{ transform:translateX(-50%); } }
  .eb-marquee:hover .eb-marquee-track{ animation-play-state:paused; }

  .eb-hero-meta{
    position:relative; z-index:3; display:flex; flex-wrap:wrap; justify-content:center;
    gap:1.5rem 2.5rem; margin-top:1.9rem;
    transition:opacity .9s ease, transform .9s ease;
  }
  .eb-js .eb-hero-meta{ opacity:0; transform:translateY(18px); }
  body.eb-loaded .eb-hero-meta{ opacity:1; transform:translateY(0); transition-delay:1.15s; }
  .eb-hero-meta div{ text-align:center; }
  .eb-hero-meta dt{ font-size:9.5px; letter-spacing:.26em; text-transform:uppercase; color:var(--dim); margin-bottom:.4rem; }
  .eb-hero-meta dd{ font-size:12.5px; font-weight:600; letter-spacing:.06em; color:var(--ink); }


  /* ================= STATS ================= */
  .eb-stats{ padding:0 1.5rem; margin-top:-2.5rem; position:relative; z-index:6; }
  .eb-stats-grid{
    display:grid; grid-template-columns:repeat(4,1fr); gap:1px;
    background:var(--line); border:1px solid var(--line); border-radius:8px; overflow:hidden;
    box-shadow:var(--e2); max-width:var(--wrap); margin:0 auto;
  }
  .eb-stat{ background:linear-gradient(180deg,var(--surface-hi),var(--surface)); padding:2rem 1.25rem; text-align:center; transition:background .3s ease; }
  .eb-stat:hover{ background:linear-gradient(180deg,#232320,#191917); }
  .eb-stat-num{
    font-family:var(--display); font-weight:400; font-size:clamp(2.2rem,4.6vw,3.4rem); line-height:1;
    background:linear-gradient(176deg,#fff 0%, #e8e7e3 45%, #a5a59f 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
    filter:drop-shadow(0 1px 0 rgba(0,0,0,.8));
  }
  .eb-stat-num .eb-sfx{ font-size:.55em; vertical-align:super; }
  .eb-stat-label{ margin-top:.65rem; font-size:10px; letter-spacing:.22em; text-transform:uppercase; color:var(--muted); }
  @media (max-width:760px){ .eb-stats-grid{ grid-template-columns:repeat(2,1fr); } }

  /* ================= CARD DECK ================= */
  .eb-deck-section{ position:relative; padding:5.5rem 1.5rem 6rem; overflow:hidden; background:transparent; }
  .eb-deck-section::before{
    content:''; position:absolute; top:-14%; left:50%; transform:translateX(-50%);
    width:min(1200px,130%); height:85%;
    background:radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.06) 0%, rgba(255,255,255,.02) 40%, transparent 70%);
    pointer-events:none;
  }
  .eb-deck-section::after{
    content:''; position:absolute; left:50%; bottom:14%; transform:translateX(-50%);
    width:min(900px,92%); height:120px;
    background:radial-gradient(ellipse at center, rgba(255,255,255,.05) 0%, transparent 70%); pointer-events:none;
  }
  .eb-deck{ position:relative; z-index:2; display:flex; flex-wrap:nowrap; justify-content:center; align-items:flex-start; gap:clamp(.6rem,3vw,2.6rem); max-width:1040px; margin:0 auto; perspective:1800px; }
  .eb-card{ position:relative; display:block; width:clamp(86px,21vw,250px); flex:0 0 auto; aspect-ratio:872/1247; text-decoration:none; outline-offset:6px; }
  .eb-js .eb-card{ opacity:0; transform:translateY(150px) rotate(var(--deal-rot,0deg)) scale(.85); }
  .eb-card::before{
    content:''; position:absolute; left:6%; right:6%; bottom:-5%; height:9%;
    background:radial-gradient(ellipse at center, rgba(0,0,0,.9) 0%, rgba(0,0,0,.45) 45%, transparent 72%);
    filter:blur(7px); z-index:-2; pointer-events:none; transition:opacity .4s ease, transform .4s ease;
  }
  .eb-card::after{
    content:''; position:absolute; inset:-9%; border-radius:8%;
    background:radial-gradient(circle, rgba(255,255,255,.26) 0%, transparent 70%);
    opacity:0; transition:opacity .4s ease; z-index:-1; pointer-events:none;
  }
  @media (hover:hover){ .eb-card:hover::after{ opacity:1; } .eb-card:hover::before{ opacity:.55; transform:translateY(6px) scale(1.06); } }
  .eb-card.is-flipped::after{ opacity:1; }
  .eb-card:nth-child(1){ --deal-rot:-12deg; }
  .eb-card:nth-child(2){ --deal-rot:6deg; }
  .eb-card:nth-child(3){ --deal-rot:-6deg; }
  .eb-card:nth-child(4){ --deal-rot:12deg; }
  .eb-deck.in-view .eb-card{ animation:eb-deal .85s cubic-bezier(.34,1.56,.64,1) forwards; }
  .eb-deck.in-view .eb-card:nth-child(1){ animation-delay:0s; }
  .eb-deck.in-view .eb-card:nth-child(2){ animation-delay:.15s; }
  .eb-deck.in-view .eb-card:nth-child(3){ animation-delay:.3s; }
  .eb-deck.in-view .eb-card:nth-child(4){ animation-delay:.45s; }
  @keyframes eb-deal{
    0%{ opacity:0; transform:translateY(150px) rotate(var(--deal-rot,0deg)) scale(.85); }
    70%{ opacity:1; transform:translateY(-10px) rotate(0deg) scale(1.03); }
    100%{ opacity:1; transform:translateY(0) rotate(0deg) scale(1); }
  }
  .eb-card.is-floating{ animation:eb-float 6s ease-in-out infinite; }
  .eb-card.is-floating:nth-child(1){ animation-delay:0s; }
  .eb-card.is-floating:nth-child(2){ animation-delay:-1.5s; }
  .eb-card.is-floating:nth-child(3){ animation-delay:-3s; }
  .eb-card.is-floating:nth-child(4){ animation-delay:-4.5s; }
  @keyframes eb-float{ 0%,100%{ transform:translateY(0) rotate(-1.2deg); } 50%{ transform:translateY(-14px) rotate(1.2deg); } }
  .eb-card-inner{ position:relative; width:100%; height:100%; transition:transform .7s cubic-bezier(.23,1,.32,1); transform-style:preserve-3d; }
  .eb-card.is-floating:hover, .eb-card.is-floating.is-flipped{ animation-play-state:paused; }
  @media (hover:hover){ .eb-card:hover .eb-card-inner{ transform:rotateY(180deg); } }
  .eb-card.is-flipped .eb-card-inner{ transform:rotateY(180deg); }
  .eb-face{ position:absolute; inset:0; border-radius:4%; backface-visibility:hidden; overflow:hidden; filter:drop-shadow(0 2px 3px rgba(0,0,0,.7)) drop-shadow(0 30px 45px rgba(0,0,0,.85)); }
  .eb-face::after{ content:''; position:absolute; inset:0; border-radius:4%; pointer-events:none; background:linear-gradient(150deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,.03) 28%, transparent 55%); mix-blend-mode:overlay; }
  .eb-face img{ position:absolute; top:-10.263%; left:-18.807%; width:137.615%; height:120.289%; max-width:none; }
  .eb-face-back{ z-index:2; }
  .eb-face-front{ transform:rotateY(180deg); }
  .eb-card:focus-visible{ outline:2px solid var(--gold); }
  @media (prefers-reduced-motion:reduce){ .eb-card{ opacity:1; transform:none; animation:none; } .eb-card-inner{ transition:transform .3s ease; } }

  /* ================= ABOUT ================= */
  .eb-about{ position:relative; z-index:6; padding:2.5rem 1.5rem 0; }
  .eb-about-card{ max-width:var(--wrap); margin:0 auto; background:linear-gradient(180deg,var(--surface-hi) 0%, var(--surface) 55%, #121211 100%); border:1px solid var(--line); border-radius:8px; box-shadow:var(--e3); overflow:hidden; }
  .eb-about-inner{
    display:grid; grid-template-columns:.85fr 1.15fr;
    gap:clamp(2rem,4vw,3.5rem); align-items:center;
    padding:clamp(2.25rem,4vw,3.25rem);
  }
  .eb-about-portrait{ display:flex; flex-direction:column; gap:1.1rem; }
  .eb-about-portrait figure{ margin:0; aspect-ratio:4/3; border-radius:5px; overflow:hidden; background:#1a1a18; border:1px solid var(--line-hi); box-shadow:var(--e1); transition:transform .4s cubic-bezier(.16,.84,.44,1), box-shadow .4s ease; }
  .eb-about-portrait figure:hover{ transform:translateY(-4px); box-shadow:var(--e2); }
  .eb-about-portrait img{ width:100%; height:100%; object-fit:cover; filter:grayscale(.15) contrast(1.06); transition:filter .4s ease; }
  .eb-about-portrait figure:hover img{ filter:grayscale(0) contrast(1.06); }
  .eb-about-copy{ display:flex; flex-direction:column; }
  .eb-about-copy .eb-label{ margin-bottom:1.1rem; }
  .eb-about-copy .eb-h2{ margin-bottom:1.5rem; }
  .eb-about-copy p{ font-size:14.5px; line-height:1.8; color:var(--body); margin:0; max-width:58ch; }
  .eb-about-copy p + p{ margin-top:1.15rem; }
  .eb-about-link{ margin-top:2.1rem; align-self:flex-start; }
  @media (max-width:860px){
    .eb-about-inner{ grid-template-columns:1fr; gap:2rem; }
    .eb-about-portrait{ max-width:340px; margin:0 auto; }
    .eb-about-portrait figure{ aspect-ratio:16/10; }
  }

  /* ================= WORK ================= */
  .eb-work-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:1.5rem; }
  .eb-work{
    position:relative; display:flex; flex-direction:column; overflow:hidden;
    background:linear-gradient(180deg,var(--surface-hi) 0%, var(--surface) 60%, #121211 100%);
    border:1px solid var(--line); border-radius:8px; box-shadow:var(--e1);
    text-decoration:none !important; color:inherit !important;
    transition:transform .4s cubic-bezier(.16,.84,.44,1), box-shadow .4s ease, border-color .3s ease;
  }
  .eb-work:hover{ transform:translateY(-6px); box-shadow:var(--e2); border-color:var(--line-hi); }
  .eb-work-feature{ grid-column:1 / -1; }
  .eb-work-media{ position:relative; overflow:hidden; aspect-ratio:16/9; background:#101010; }
  .eb-work-feature .eb-work-media{ aspect-ratio:21/9; }
  .eb-work-media img{ width:100%; height:100%; object-fit:cover; filter:grayscale(.35) contrast(1.05); transition:transform .7s cubic-bezier(.16,.84,.44,1), filter .5s ease; }
  .eb-work:hover .eb-work-media img{ transform:scale(1.06); filter:grayscale(0) contrast(1.05); }
  .eb-work-media::after{ content:''; position:absolute; inset:0; background:linear-gradient(180deg, transparent 40%, rgba(10,10,10,.85) 100%); pointer-events:none; }
  .eb-work-suit{
    position:absolute; top:14px; right:14px; z-index:2; width:34px; height:34px; border-radius:50%;
    display:flex; align-items:center; justify-content:center; font-size:15px; color:var(--gold);
    background:rgba(10,10,10,.75); border:1px solid var(--line-hi);
    backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px);
  }
  .eb-work-body{ padding:1.5rem 1.6rem 1.7rem; display:flex; flex-direction:column; flex:1; }
  .eb-work-tags{ display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:.9rem; }
  .eb-tag{ font-size:9.5px; letter-spacing:.16em; text-transform:uppercase; font-weight:600; color:var(--muted); padding:5px 9px; border:1px solid var(--line-hi); border-radius:3px; background:rgba(255,255,255,.02); }
  .eb-work h3{ font-family:var(--display); font-weight:400; text-transform:uppercase; letter-spacing:.01em; font-size:clamp(1.4rem,2.4vw,2rem); line-height:1; margin:0 0 .7rem; color:var(--ink); }
  .eb-work p{ font-size:13.5px; line-height:1.7; color:var(--body); margin:0; }
  .eb-work-more{ margin-top:1.2rem; display:inline-flex; align-items:center; gap:.6rem; font-size:10px; font-weight:600; letter-spacing:.22em; text-transform:uppercase; color:var(--gold); transition:gap .3s ease; }
  .eb-work:hover .eb-work-more{ gap:1.1rem; }
  @media (max-width:820px){ .eb-work-grid{ grid-template-columns:1fr; } }

  /* ================= RESEARCH ================= */
  .eb-research{ display:grid; grid-template-columns:1.05fr .95fr; gap:clamp(2rem,5vw,4rem); align-items:center; }
  .eb-research-gallery{ display:flex; flex-direction:column; gap:1.1rem; }
  .eb-research-media{ position:relative; border-radius:8px; overflow:hidden; border:1px solid var(--line-hi); box-shadow:var(--e2); aspect-ratio:4/3; background:#101010; transition:transform .4s cubic-bezier(.16,.84,.44,1), box-shadow .4s ease; }
  .eb-research-media:hover{ transform:translateY(-4px); box-shadow:var(--e3); }
  .eb-research-media.is-short{ aspect-ratio:16/9; }
  .eb-research-media img{ width:100%; height:100%; object-fit:cover; filter:grayscale(.3) contrast(1.08); }
  .eb-research-media::after{ content:''; position:absolute; inset:0; background:linear-gradient(160deg, rgba(255,255,255,.08), transparent 45%); pointer-events:none; }
  .eb-research-badge{
    position:absolute; left:16px; bottom:16px; z-index:2; padding:9px 14px; border-radius:4px;
    background:rgba(8,8,8,.85); border:1px solid var(--line-hi);
    backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px);
    font-size:9.5px; letter-spacing:.22em; text-transform:uppercase; font-weight:600; color:var(--gold);
  }
  .eb-research-facts{ display:grid; grid-template-columns:repeat(2,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:6px; overflow:hidden; margin:1.8rem 0; }
  .eb-research-facts div{ background:var(--surface); padding:1.1rem 1.2rem; }
  .eb-research-facts dt{ font-size:9.5px; letter-spacing:.22em; text-transform:uppercase; color:var(--dim); margin-bottom:.45rem; }
  .eb-research-facts dd{ font-size:13px; font-weight:600; color:var(--ink); line-height:1.4; }
  @media (max-width:860px){ .eb-research{ grid-template-columns:1fr; } }

  /* ================= ROADMAP ================= */
  .eb-timeline{ position:relative; max-width:840px; margin:0 auto; }
  .eb-tl-org-head{
    display:flex; align-items:baseline; gap:1rem; flex-wrap:wrap;
    margin:3rem 0 1.6rem; padding-bottom:.8rem; border-bottom:1px solid var(--line);
  }
  .eb-timeline > .eb-tl-org-head:first-child{ margin-top:0; }
  .eb-tl-org-head h3{
    font-family:var(--display); font-weight:400; text-transform:uppercase; letter-spacing:.02em;
    font-size:1.5rem; line-height:1; margin:0; color:var(--ink);
  }
  .eb-tl-org-head span{ font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:var(--dim); }
  .eb-tl-group{ position:relative; padding-left:2.6rem; }
  .eb-tl-group::before{
    content:''; position:absolute; left:9px; top:4px; bottom:4px; width:1px;
    background:linear-gradient(180deg, transparent, var(--line-hi) 6%, var(--line-hi) 94%, transparent);
  }
  .eb-tl-item{ position:relative; padding-bottom:2.2rem; }
  .eb-tl-item:last-child{ padding-bottom:0; }
  .eb-tl-item::before{
    content:''; position:absolute; left:-2.6rem; top:4px; width:19px; height:19px; border-radius:50%;
    background:linear-gradient(180deg,#232320,#141412); border:1px solid var(--line-hi);
    box-shadow:inset 0 1px 0 rgba(255,255,255,.09), 0 6px 14px -6px rgba(0,0,0,1);
  }
  .eb-tl-item::after{ content:attr(data-suit); position:absolute; left:calc(-2.6rem + 5px); top:5px; font-size:10px; line-height:19px; color:var(--gold); }
  .eb-tl-item.is-now::before{ border-color:var(--gold); box-shadow:inset 0 1px 0 rgba(255,255,255,.12), 0 0 18px rgba(216,216,211,.35); }
  .eb-tl-year{ font-size:10px; letter-spacing:.24em; text-transform:uppercase; color:var(--gold); margin-bottom:.45rem; font-weight:600; }
  .eb-tl-item h4{ font-family:var(--display); font-weight:400; text-transform:uppercase; font-size:1.25rem; line-height:1.1; letter-spacing:.01em; margin:0 0 .3rem; color:var(--ink); }
  .eb-tl-loc{ font-size:11px; letter-spacing:.06em; color:var(--dim); margin-bottom:.7rem; }
  .eb-tl-item p{ font-size:13.5px; line-height:1.7; color:var(--body); margin:0; }
  .eb-tl-bullets{ list-style:none; margin:.8rem 0 0; display:flex; flex-direction:column; gap:.4rem; }
  .eb-tl-bullets li{ position:relative; padding-left:1.1rem; font-size:13px; line-height:1.6; color:var(--body); }
  .eb-tl-bullets li::before{ content:'—'; position:absolute; left:0; color:var(--gold); }
  .eb-tl-ach{ margin-top:1rem; padding:1.1rem 1.2rem; border:1px solid var(--line); border-radius:6px; background:rgba(255,255,255,.02); }
  .eb-tl-ach h5{ font-size:9.5px; letter-spacing:.22em; text-transform:uppercase; color:var(--gold-soft); margin:0 0 .7rem; font-weight:600; }
  .eb-tl-ach ul{ list-style:none; display:flex; flex-direction:column; gap:.35rem; }
  .eb-tl-ach li{ position:relative; padding-left:1rem; font-size:12.5px; line-height:1.55; color:var(--body); }
  .eb-tl-ach li::before{ content:'·'; position:absolute; left:.25rem; color:var(--gold); font-weight:700; }
  .eb-tl-ach + .eb-tl-ach{ margin-top:.7rem; }

  /* ================= AWARDS ================= */
  .eb-awards{ max-width:960px; margin:0 auto; border-top:1px solid var(--line); }
  .eb-award{ display:grid; grid-template-columns:88px 1fr 200px 120px; gap:1.2rem; align-items:center; padding:1.15rem .6rem; border-bottom:1px solid var(--line); transition:background .25s ease, padding-left .25s ease; }
  .eb-award:hover{ background:rgba(255,255,255,.025); padding-left:1.1rem; }
  .eb-award-year{ font-family:var(--display); font-size:1.15rem; color:var(--gold); letter-spacing:.02em; }
  .eb-award-name{ font-size:14px; font-weight:600; color:var(--ink); letter-spacing:.01em; }
  .eb-award-cat{ font-size:11.5px; letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }
  .eb-award-place{ justify-self:start; font-size:9.5px; letter-spacing:.16em; text-transform:uppercase; font-weight:600; padding:5px 10px; border-radius:3px; border:1px solid var(--line-hi); color:var(--body); white-space:nowrap; }
  .eb-award-place.is-top{ color:#0a0a0a; background:var(--gold); border-color:var(--gold); }
  @media (max-width:760px){
    .eb-award{ grid-template-columns:70px 1fr; gap:.5rem 1rem; }
    .eb-award-cat, .eb-award-place{ grid-column:2; }
  }
  .eb-extras{ max-width:960px; margin:2.5rem auto 0; display:grid; grid-template-columns:repeat(3,1fr); gap:1px; background:var(--line); border:1px solid var(--line); border-radius:6px; overflow:hidden; }
  .eb-extras > div{ background:var(--surface); padding:1.4rem; }
