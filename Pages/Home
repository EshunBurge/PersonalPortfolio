<script>
(function(){
  /* Tells the CSS that JS is alive. Without this class nothing is hidden,
     so a stripped <script> degrades to a fully visible, static page. */
  document.documentElement.classList.add('eb-js');

  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- side panel menu: CSS drives it; JS only adds polish ---- */
  (function(){
    var cb = document.getElementById('ebMenuToggle'),
        panel = document.getElementById('ebPanel');
    if (!cb || !panel) return;

    function sync(){
      var open = cb.checked;
      document.body.classList.toggle('eb-locked', open);
      panel.setAttribute('aria-hidden', open ? 'false' : 'true');
      if (open){
        var first = panel.querySelector('a');
        if (first) setTimeout(function(){ first.focus(); }, 320);
      }
    }
    cb.addEventListener('change', sync);
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape' && cb.checked){ cb.checked = false; sync(); cb.focus(); }
    });
    panel.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ cb.checked = false; sync(); });
    });

    var path = window.location.pathname.replace(/\/$/,'');
    panel.querySelectorAll('.eb-sp-links a').forEach(function(a){
      var href = a.getAttribute('href').replace(/\/$/,'');
      if (href === path) a.classList.add('is-active');
    });
    sync();
  })();

  /* ---- size the name to fill the hero width, whatever font loads ---- */
  function fitName(){
    var el = document.getElementById('ebName');
    if (!el || !el.parentElement) return;
    var box = el.parentElement, cs = getComputedStyle(box);
    var avail = box.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
    if (avail <= 0) return;
    el.style.fontSize = '100px';
    el.style.width = 'max-content'; el.style.maxWidth = 'none';
    var natural = el.getBoundingClientRect().width;
    el.style.width = ''; el.style.maxWidth = '';
    if (!natural) return;
    /* narrow screens get a wider safety margin so the name never kisses the edge */
    var fill = window.innerWidth <= 680 ? 0.94 : 0.99;
    var size = 100 * (avail * fill) / natural;
    size = Math.max(30, Math.min(size, window.innerHeight * 0.38));
    el.style.fontSize = size.toFixed(2) + 'px';
  }

  /* ---- split the name into per-letter spans ---- */
  (function(){
    var el = document.getElementById('ebName');
    if (!el) return;
    var name = el.getAttribute('data-name') || el.textContent;
    var words = name.trim().split(/\s+/);
    el.textContent = '';
    var i = 0;
    words.forEach(function(word){
      var w = document.createElement('span'); w.className = 'eb-word';
      word.split('').forEach(function(ch){
        var s = document.createElement('span');
        s.className = 'eb-ch'; s.textContent = ch;
        s.style.transitionDelay = (0.45 + i * 0.045) + 's';
        w.appendChild(s); i++;
      });
      el.appendChild(w);
    });
    el.setAttribute('aria-label', name);
  })();

  fitName();
  window.addEventListener('resize', fitName);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(fitName);
  setTimeout(fitName, 800);

  function markLoaded(){
    requestAnimationFrame(function(){
      document.body.classList.add('eb-loaded');
      var chars = document.querySelectorAll('.eb-name .eb-ch');
      if (!chars.length) return;
      var last = 450 + (chars.length * 45) + 800;
      setTimeout(function(){
        chars.forEach(function(c){ c.style.transitionDelay = '0s'; c.style.willChange = 'auto'; });
      }, reduce ? 0 : last);
    });
  }
  if (document.readyState === 'complete') markLoaded();
  else window.addEventListener('load', markLoaded);

  /* ---- suit parallax ---- */
  (function(){
    var suits = Array.prototype.slice.call(document.querySelectorAll('.eb-suit'));
    if (!suits.length || reduce) return;
    var cx = window.innerWidth/2, cy = window.innerHeight/2;
    window.addEventListener('mousemove', function(e){
      var dx = (e.clientX-cx)/cx, dy = (e.clientY-cy)/cy;
      suits.forEach(function(el){
        var d = parseFloat(el.dataset.depth) || 20;
        el.style.transform = 'translate('+(dx*d)+'px,'+(dy*d)+'px)';
      });
    });
    window.addEventListener('resize', function(){ cx = window.innerWidth/2; cy = window.innerHeight/2; });
  })();

  /* ---- hero scroll parallax ---- */
  (function(){
    var bg = document.getElementById('ebHeroBg'), content = document.getElementById('ebHeroContent');
    if (!bg || !content || reduce) return;
    var ticking = false;
    function update(){
      var y = window.scrollY;
      if (y < window.innerHeight * 1.2){
        bg.style.transform = 'translate3d(0,'+(y*0.28)+'px,0)';
        content.style.transform = 'translate3d(0,'+(y*0.1)+'px,0)';
        content.style.opacity = Math.max(0, 1 - (y/(window.innerHeight*0.8)));
      }
      ticking = false;
    }
    window.addEventListener('scroll', function(){ if(!ticking){ ticking = true; requestAnimationFrame(update); } }, {passive:true});
    update();
  })();

  /* ---- card deck ---- */
  (function(){
    var deck = document.querySelector('.eb-deck'), cards = document.querySelectorAll('.eb-card');
    if (!deck) return;
    function revealNow(){ deck.classList.add('in-view'); cards.forEach(function(c){ c.classList.add('is-floating'); }); }
    if (reduce || !('IntersectionObserver' in window)) revealNow();
    else {
      var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          if (!en.isIntersecting) return;
          deck.classList.add('in-view');
          setTimeout(function(){ cards.forEach(function(c){ c.classList.add('is-floating'); }); }, 1300);
          obs.unobserve(en.target);
        });
      }, {threshold:0.35});
      obs.observe(deck);
    }
    /* On touch there is no hover, so CSS already presents the ace face up.
       A tap should therefore just follow the link — no flip step in the way. */
  })();

  /* ---- stat count-up ---- */
  (function(){
    var nums = document.querySelectorAll('.eb-stat-num[data-count]');
    if (!nums.length) return;
    function paint(el, val){
      var sfx = el.dataset.suffix || '';
      el.textContent = Number(val).toLocaleString('en-US');
      if (sfx){
        var s = document.createElement('span');
        s.className = 'eb-sfx'; s.textContent = sfx;
        el.appendChild(s);
      }
    }
    if (reduce || !('IntersectionObserver' in window)){
      nums.forEach(function(el){ paint(el, el.dataset.count); });
      return;
    }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (!en.isIntersecting) return;
        var el = en.target, target = parseInt(el.dataset.count,10) || 0, start = null, dur = 1400;
        function step(ts){
          if (!start) start = ts;
          var p = Math.min((ts-start)/dur, 1), eased = 1 - Math.pow(1-p,3);
          paint(el, Math.round(target*eased));
          if (p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
        obs.unobserve(el);
      });
    }, {threshold:0.5});
    nums.forEach(function(el){ paint(el, 0); obs.observe(el); });
  })();

  /* ---- scroll reveal ---- */
  (function(){
    var items = document.querySelectorAll('.eb-reveal, .eb-reveal-left');
    if (!items.length) return;
    if (reduce || !('IntersectionObserver' in window)){
      items.forEach(function(el){ el.classList.add('is-visible'); });
      return;
    }
    var obs = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if (en.isIntersecting){ en.target.classList.add('is-visible'); obs.unobserve(en.target); }
      });
    }, {threshold:0.12, rootMargin:'0px 0px -40px 0px'});
    items.forEach(function(el){ obs.observe(el); });
  })();

  /* ---- rail scroll-spy: highlight the section you're in ---- */
  (function(){
    var rail = document.getElementById('ebRail');
    if (!rail) return;
    var links = Array.prototype.slice.call(rail.querySelectorAll('a'));
    var targets = links.map(function(a){
      return document.querySelector(a.getAttribute('href'));
    });
    var ticking = false;
    function update(){
      var mark = window.scrollY + window.innerHeight * 0.35;
      var best = 0;
      targets.forEach(function(el, i){
        if (el && el.offsetTop <= mark) best = i;
      });
      // pin the last item once the page bottom is reached
      if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4){
        best = links.length - 1;
      }
      links.forEach(function(a, i){
        a.classList.toggle('is-current', i === best);
        if (i === best) a.setAttribute('aria-current','true');
        else a.removeAttribute('aria-current');
      });
      ticking = false;
    }
    window.addEventListener('scroll', function(){
      if (!ticking){ ticking = true; requestAnimationFrame(update); }
    }, {passive:true});
    window.addEventListener('resize', update);
    update();
  })();

  /* ---- footer year ---- */
  (function(){
    var y = document.getElementById('ebYear');
    if (y) y.textContent = new Date().getFullYear();
  })();
})();
</script>
