<!-- ============== BIO ============== -->
<section class="eb-bio" id="bio">
  <div class="eb-bio-card eb-reveal">
    <div class="eb-bio-inner">

      <div class="eb-gallery">
        <figure>
          <img loading="lazy" decoding="async" src="https://eshun.net/wp-content/uploads/2026/07/i_6abUd018svcc7bpfwwxrnll_dh9nhn.jpg" alt="Eshun Burge">
